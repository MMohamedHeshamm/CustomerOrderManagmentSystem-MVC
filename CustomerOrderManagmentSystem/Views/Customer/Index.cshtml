@model IEnumerable<CustomerOrderManagmentSystem.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<h1>Table of Customers</h1>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CustomerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerPassword)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Orders)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CustomerId)
            </td>

            <td>
                @Html.DisplayFor(model => item.CustomerName)
            </td>
            <td>
                @Html.DisplayFor(model => item.CustomerEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.CustomerPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.CustomerPassword)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Orders)
            </td> *@
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a> |
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.CustomerId">Details</a> |
                    <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.CustomerId">Delete</a>
                    <a class="btn btn-primary" asp-action="ShowAllOrder" asp-route-id="@item.CustomerId">Show all Orders</a>
            </td>
        </tr>
}
    </tbody>
</table>
<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
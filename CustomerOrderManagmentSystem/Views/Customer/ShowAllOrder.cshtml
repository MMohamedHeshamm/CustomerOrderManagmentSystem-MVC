@model IEnumerable<CustomerOrderManagmentSystem.Models.Order>

@{
    ViewData["Title"] = "Index";
}

<h1>Table Of Orders</h1>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.OrderTitle)
                </td>
                <td>
                    @Html.DisplayFor(model => item.OrderDescription)
                </td>
                <td>
                    @Html.DisplayFor(model => item.OrderStatus)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CustomerId)
                </td>
                <td>
                    <a class="btn btn-primary"asp-controller="Order" asp-action="Edit" asp-route-id="@item.OrderId">Edit</a> |
                    <a class="btn btn-primary" asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId">Details</a> |
                    <a class="btn btn-primary" asp-controller="Order" asp-action="Delete" asp-route-id="@item.OrderId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>